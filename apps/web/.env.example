NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=your-kakao-javascript-key
# 카카오 로그인(간편로그인)용 REST API 키. 백엔드 apps/api의 KAKAO_REST_API_KEY와
# 반드시 같은 값이어야 함(같은 카카오 앱의 client_id). 카카오 개발자 콘솔 >
# 카카오 로그인 > Redirect URI에 "{배포 도메인}/login/kakao/callback"을 등록해야 함
# (redirect_uri는 로그인 시점에 현재 origin 기준으로 자동 계산되어 전송됨).
NEXT_PUBLIC_KAKAO_CLIENT_ID=your-kakao-rest-api-key
