DATABASE_URL=postgresql+psycopg://zippalgo:zippalgo@localhost:5432/zippalgo360_db
JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
ZIPTERIOR_API_BASE_URL=https://zipterior.kr
SSO_SHARED_SECRET=change-this-in-production
SSO_CODE_TTL_SECONDS=30
# 카카오 개발자 콘솔 > 앱 설정 > 앱 키 > REST API 키 (JavaScript 키와 다름).
# 업체 가입 시 주소를 지도 좌표로 변환하는 지오코딩과, 카카오 간편로그인(OAuth
# client_id)에 공용으로 쓰인다. 비워두면 지오코딩은 건너뛰고(가입은 정상
# 진행), 카카오 로그인은 /auth/kakao/login 호출 시 501로 비활성 처리된다.
KAKAO_REST_API_KEY=
# 카카오 개발자 콘솔에서 "Client Secret 사용"을 켠 경우에만 필요. 기본은 꺼져
# 있어 비워둬도 됨.
KAKAO_CLIENT_SECRET=
# 카카오 개발자 콘솔 > 카카오 로그인 > Redirect URI에 등록한 값과 정확히
# 일치해야 함. 로컬 개발은 기본값 그대로, 배포 환경은 실제 도메인으로 교체.
KAKAO_REDIRECT_URI=http://localhost:3000/login/kakao/callback
